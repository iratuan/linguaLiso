{
  "name": "english-teacher-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Interface desktop do English Teacher Local (React + Vite + Electron)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:start": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "lucide-react": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.iratu.englishteacher",
    "productName": "English Teacher Local",
    "copyright": "Uso pessoal",
    "directories": {
      "output": "../build/installer",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/staging/runtime",
        "to": "runtime"
      },
      {
        "from": "../build/staging/backend",
        "to": "backend"
      },
      {
        "from": "../build/staging/ai-model",
        "to": "ai-model"
      },
      {
        "from": "../build/staging/scripts",
        "to": "scripts"
      }
    ],
    "win": {
      "icon": "electron/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "installerSidebar": "build-resources/installerSidebar.bmp",
      "uninstallerSidebar": "build-resources/installerSidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "English Teacher",
      "artifactName": "English-Teacher-Setup-${version}.${ext}"
    }
  }
}
